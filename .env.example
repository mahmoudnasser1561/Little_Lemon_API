# Copy this file to .env and fill in real values. .env is gitignored and never committed -
# docker-compose.yml reads it automatically and refuses to start without it.

POSTGRES_DB=littlelemon
POSTGRES_USER=littlelemon
POSTGRES_PASSWORD=change-me

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# False for a production-style run (recommended); True shows full error pages if something breaks
DEBUG=False

# Comma-separated, e.g. localhost,127.0.0.1 - or * for a local-only demo
ALLOWED_HOSTS=*
